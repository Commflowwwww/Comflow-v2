/* ===== PALETA DE CORES & VARIÁVEIS BOSCH ===== */
:root {
    --bosch-red: #EA0016;
    --bosch-dark: #1A1A1A;
    --bosch-blue: #006EAD;
    --bosch-blue-hover: #005691;
    --bosch-light-gray: #F4F7F9;
    --bosch-gray: #E0E2E5;
    --text-dark: #1e293b;
    --text-light: #64748b;
}

/* ===== RESET & BASE ===== */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

body {
    background: linear-gradient(135deg, #005691 0%, #008ecf 100%);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
}

/* ===== CONTAINER PRINCIPAL ===== */
.login-container,
.register-container {
    width: 100%;
    max-width: 450px;
    animation: fadeInUp 0.6s ease;
}

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* ===== LOGO BOSCH NO TOPO ===== */
.login-header,
.register-header {
    text-align: center;
    margin-bottom: 30px;
}

.bosch-logo-login {
    height: 45px;
    filter: brightness(0) invert(1); /* Torna o logo branco */
}

/* ===== CARD DE CADASTRO ===== */
.login-card,
.register-card {
    background: #ffffff;
    border-radius: 16px;
    padding: 40px 35px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    position: relative;
    overflow: hidden;
}

/* Faixa superior vermelha Bosch */
.login-card::before,
.register-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 6px;
    background: var(--bosch-red);
}

/* ===== LOGO COMMFLOW ===== */
.commflow-logo-login {
    text-align: center;
    margin-bottom: 20px;
}

.commflow-logo-login img {
    height: 50px;
}

/* ===== TÍTULOS & SUBTÍTULOS ===== */
.login-card h2,
.register-card h2 {
    font-size: 1.5rem;
    color: var(--text-dark);
    text-align: center;
    margin-bottom: 8px;
    font-weight: 600;
}

.login-subtitle {
    color: var(--text-light);
    text-align: center;
    font-size: 0.9rem;
    margin-bottom: 25px;
}

/* ===== GRUPOS DE INPUT ===== */
.input-group {
    margin-bottom: 18px;
}

.input-group label {
    display: block;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-dark);
    margin-bottom: 6px;
}

.input-group input {
    width: 100%;
    padding: 12px 16px;
    border: 2px solid var(--bosch-gray);
    border-radius: 8px;
    font-size: 0.95rem;
    color: var(--text-dark);
    background: #ffffff;
    transition: all 0.3s ease;
}

.input-group input:focus {
    outline: none;
    border-color: var(--bosch-blue);
    box-shadow: 0 0 0 3px rgba(0, 110, 173, 0.15);
}

/* ===== BOTÃO DE SUBMISSÃO ===== */
.btn-login,
.btn-register {
    width: 100%;
    background: var(--bosch-blue);
    color: #ffffff;
    border: none;
    padding: 14px;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 10px;
    transition: all 0.3s ease;
    box-shadow: 0 4px 12px rgba(0, 110, 173, 0.3);
}

.btn-login:hover,
.btn-register:hover {
    background: var(--bosch-blue-hover);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 110, 173, 0.4);
}

.btn-login:active,
.btn-register:active {
    transform: translateY(0);
}

/* ===== RODAPÉ DO CARD (LINK VOLTAR PARA LOGIN) ===== */
.login-footer {
    text-align: center;
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid var(--bosch-gray);
    font-size: 0.85rem;
}

.login-footer a {
    color: var(--bosch-blue);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s ease;
}

.login-footer a:hover {
    color: var(--bosch-red);
    text-decoration: underline;
}

/* ===== RODAPÉ EXTERNO DA PÁGINA ===== */
.login-bottom {
    text-align: center;
    margin-top: 30px;
    color: #ffffff;
    font-size: 0.85rem;
}

.login-bottom p {
    margin-bottom: 10px;
    opacity: 0.9;
}

.login-links {
    display: flex;
    justify-content: center;
    gap: 20px;
}

.login-links a {
    color: #ffffff;
    text-decoration: none;
    opacity: 0.8;
    transition: opacity 0.2s ease;
}

.login-links a:hover {
    opacity: 1;
    text-decoration: underline;
}

/* ===== ANIMAÇÃO DE ERRO (SHAKE) ===== */
@keyframes shake {
    0%, 100% { transform: translateX(0); }
    10%, 30%, 50%, 70%, 90% { transform: translateX(-8px); }
    20%, 40%, 60%, 80% { transform: translateX(8px); }
}

.shake {
    animation: shake 0.5s ease;
}

/* ===== RESPONSIVIDADE ===== */
@media (max-width: 480px) {
    .login-card,
    .register-card {
        padding: 30px 20px;
    }

    .bosch-logo-login {
        height: 35px;
    }

    .commflow-logo-login img {
        height: 40px;
    }
}
